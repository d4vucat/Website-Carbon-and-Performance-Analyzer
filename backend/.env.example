# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000
DB_PATH=./data/analyzer.db

# ── Free APIs (no key required) ──────────────────────────────
# These work out of the box:
#   ip-api.com         → IP geolocation + ASN + hosting flag
#   OSV API            → Open-source vulnerability scanning
#   HSTS Preload API   → hstspreload.org domain status
#   RDAP               → Modern WHOIS (rdap.org universal proxy)

# ── Optional: Chrome UX Report (CrUX) ────────────────────────
# Free: 150 req/day — get key at console.cloud.google.com
# Enable BigQuery API → create API key → restrict to CrUX API
CRUX_API_KEY=

# ── Optional: Qualys SSL Labs ────────────────────────────────
# Free (rate limited ~1 req/10s per domain) — no key needed
# Set to 'true' to enable (slow: +90s per analysis)
ENABLE_SSLLABS=false

# ── Optional: Cloudflare Radar ───────────────────────────────
# Free tier with Cloudflare account — cloudflare.com/dashboard
# Go to: My Profile → API Tokens → Create Token → Radar Read
CLOUDFLARE_API_KEY=
CLOUDFLARE_EMAIL=

# ── Optional: Electricity Maps (real-time carbon intensity) ──
# Free tier: 50 req/month — electricitymap.org
# Better than static country averages for server carbon calc
ELECTRICITY_MAPS_API_KEY=

# ── Optional: CO2signal (alternative to Electricity Maps) ────
# Free with account — co2signal.com
CO2SIGNAL_API_KEY=

# ── Optional: WattTime (most granular grid intensity) ────────
# Free tier available — watttime.org
WATTTIME_USER=
WATTTIME_PASSWORD=

# ── Optional: MaxMind GeoIP2 ────────────────────────────────
# Free GeoLite2 City MMDB — maxmind.com/en/geolite2/signup
# Download GeoLite2-City.mmdb → place in backend/data/
# MMDB_PATH is auto-detected at ./data/GeoLite2-City.mmdb

# ── Optional: BuiltWith API ──────────────────────────────────
# Free tier: 1,000 req/mo — builtwith.com/free-signup
BUILTWITH_API_KEY=

# ── Optional: WhoisJSON API ──────────────────────────────────
# WHOIS/RDAP fallback — free tier: 1,000 req/mo
# Sign up: https://whoisjson.com/login
WHOISJSON_API_KEY=

# ── Optional: Browserbase (cloud browser) ────────────────────
# Bypasses Cloudflare, Akamai, and other bot-protection systems.
# Without Browserbase, sites like claude.ai / chatgpt.com will
# show 0 ms LCP and missing metrics because local Playwright
# gets blocked. With Browserbase, real metrics are captured.
#
# Free tier: 1,000 sessions/month — https://www.browserbase.com
# 1. Create account → Dashboard → Settings → copy API Key + Project ID
# 2. Set BROWSERBASE_STEALTH=true to enable residential proxy rotation
#    and browser fingerprint randomization (recommended).
#
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
BROWSERBASE_STEALTH=true
#
# Max concurrent Browserbase sessions (free plan allows 3):
BROWSERBASE_MAX_CONCURRENT=3

# ── Browser pool (local Playwright — used when Browserbase is off) ──
BROWSER_POOL_SIZE=3
BROWSER_MAX_USES=50
